        // Campos según el estatus elegido (Duplicado pide el folio original; No requiere atención, el motivo)
        function actualizarCamposCierre() {
            const e = document.getElementById('seguimiento_estado').value;
            document.getElementById('grupoFolioOriginal').hidden = e !== 'E';
            document.getElementById('etqDescripcion').innerHTML = e === 'F'
                ? 'Motivo por el que no requiere atención <span class="req" aria-hidden="true">*</span>'
                : 'Descripción del seguimiento <span class="opc">(opcional)</span>';
            const ayuda = {
                B: 'El área ya conoce el hallazgo.',
                C: 'El hallazgo se está atendiendo.',
                D: 'El hallazgo quedó atendido. No se permite si hay acciones correctivas abiertas o sin verificar.',
                E: 'Cierra el reporte porque el mismo hallazgo ya está registrado en otro reporte.',
                F: 'Cierra el reporte porque se revisó y no requiere acción.'
            };
            document.getElementById('ayudaEstado').textContent = ayuda[e] || '';
        }
        document.addEventListener('change', function (ev) {
            if (ev.target && ev.target.id === 'seguimiento_estado') actualizarCamposCierre();
        });

        function formatearFecha(fecha) {
            return new Date(fecha).toLocaleDateString('es-MX', {
                day: '2-digit',
                month: 'short',
                year: 'numeric',
                hour: '2-digit',
                minute: '2-digit'
            });
        }

        function truncar(texto, max) {
            if (!texto) return '';
            return texto.length > max ? texto.substring(0, max) + '...' : texto;
        }

        function traducirEstado(estado) {
            const estados = {
                'A': 'Generado',
                'B': 'Enterado',
                'C': 'En Atención',
                'D': 'Resuelto',
                'E': 'Duplicado',
                'F': 'No Requiere'
            };
            return estados[estado] || estado;
        }

        function mostrarToast(mensaje, tipo) {
            SAGA.toast(mensaje, tipo || 'error');
        }

        // CARGAR DEPARTAMENTOS RESPONSABLES EN FILTRO
        // ===========================================
        async function cargarDepartamentosResponsables() {
            try {
                console.log('Cargando departamentos responsables...');
                const response = await fetch('/api/departamentos-responsables');
                const data = await response.json();
                
                if (data.success && data.departamentos) {
                    // Llenar AMBOS selects de departamentos responsables
                    const selectSeguimientos = document.getElementById('filtro_seg_departamento_responsable');
                    const selectNotificados = document.getElementById('filtro_notif_dept_responsable');

                    // Limpiar opciones existentes excepto "Todos"
                    // Llenar select de Seguimientos
                    if (selectSeguimientos) {
                        while (selectSeguimientos.options.length > 1) {
                            selectSeguimientos.remove(1);
                        }
                        data.departamentos.forEach(dept => {
                            const option = document.createElement('option');
                            option.value = dept.id;
                            option.textContent = `${dept.nombre}`;
                            selectSeguimientos.appendChild(option);
                        });
                    }

                    // Llenar select de Notificados
                    if (selectNotificados) {
                        while (selectNotificados.options.length > 1) {
                            selectNotificados.remove(1);
                        }
                        data.departamentos.forEach(dept => {
                            const option = document.createElement('option');
                            option.value = dept.id;
                            option.textContent = `${dept.nombre}`;
                            selectNotificados.appendChild(option);
                        });
                    }
                    
                    console.log(`${data.departamentos.length} departamentos responsables cargados`);
                }
            } catch (error) {
                console.error('Error cargando departamentos responsables:', error);
            }
        }


        
        
