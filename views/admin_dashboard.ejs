        async function cargarSeguimientosNotificados() {
            try {
                console.log('Cargando seguimientos notificados...');
                
                // Construir URL con filtros
                let url = `/api/departamento/${DEPARTAMENTO_ID}/seguimientos-notificados?`;
                
                const desde = document.getElementById('filtro_notif_desde').value;
                const hasta = document.getElementById('filtro_notif_hasta').value;
                const deptResp = document.getElementById('filtro_notif_dept_responsable').value;
                const tipo = document.getElementById('filtro_notif_tipo').value;
                const estado = document.getElementById('filtro_notif_estado').value;
                const orden = document.getElementById('filtro_notif_orden').value;
                
                console.log('Filtros notificados:', { desde, hasta, deptResp, tipo, estado, orden });
                
                if (desde && hasta) url += `desde=${desde}&hasta=${hasta}&`;
                if (tipo) url += `tipo_problema=${encodeURIComponent(tipo)}&`;
                if (estado) url += `estado=${estado}&`;
                if (orden) url += `orden=${orden}&`;
                
                console.log('URL notificados:', url);
                
                const response = await fetch(url);
                const data = await response.json();
                
                const tbody = document.getElementById('notificadosBody');
                
                if (!data.success || !data.seguimientos || data.seguimientos.length === 0) {
                    tbody.innerHTML = `
                        <tr>
                            <td colspan="9" class="empty-state">
                                ${SAGA.icono('inbox')}
                                <p>No hay seguimientos notificados para mostrar</p>
                            </td>
                        </tr>
                    `;
                    return;
                }
                
                tbody.innerHTML = data.seguimientos.map(s => `
                    <tr>
                        <td><span class="folio-badge">${s.folio_seguimiento}</span></td>
                        <td>${formatearFecha(s.reporte_fecha)}</td>
                        <td>${formatearFecha(s.seguimiento_fecha)}</td>
                        <td>
                            <span class="sg-chip">
                                ${esc(s.departamento_responsable_nombre)}
                            </span>
                        </td>
                        <td><strong>${esc(s.tipo_problema)}</strong></td>
                        <td>${esc(truncar(s.reporte_descripcion, 60))}</td>
                        <td>${s.seguimiento_descripcion ? esc(truncar(s.seguimiento_descripcion, 60)) : '<em class="nd">Sin descripción</em>'}</td>
                        <td>
                            <span class="estado-badge estado-${s.seguimiento_estado}">
                                ${traducirEstado(s.seguimiento_estado)}
                            </span>
                        </td>
                        <td>
                            <a href="/reportes/${s.reporte_folio}/historial" target="_blank" rel="noopener" class="btn btn-secondary btn-sm btn-ver">${SAGA.icono('history')}
                                Historial
                            </a>
                        </td>
                    </tr>
                `).join('');
                
                console.log(`${data.seguimientos.length} seguimientos notificados cargados`);
                
            } catch (error) {
                console.error(' Error cargando seguimientos notificados:', error);
                document.getElementById('notificadosBody').innerHTML = `
                    <tr>
                        <td colspan="9" class="empty-state">
                            ${SAGA.icono('crit')}
                            <p>Error al cargar los seguimientos</p>
                        </td>
                    </tr>
                `;
            }
        }
        
        
