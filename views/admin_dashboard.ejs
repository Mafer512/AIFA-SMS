         //Inicializar pestañas del modal
        function inicializarPestañasModal() {
            const tabButtons = document.querySelectorAll('.tab-modal');
            const tabContents = document.querySelectorAll('#modalSeguimiento .tab-content');
            
            tabButtons.forEach(button => {
                button.addEventListener('click', () => {
                    console.log('Cambiando pestaña:', button.getAttribute('data-tab'));
                    
                    // Remover active de todos los botones y contenidos del modal
                    tabButtons.forEach(btn => btn.classList.remove('active'));
                    tabContents.forEach(content => content.classList.remove('active'));
                    
                    // Agregar active al clickeado
                    button.classList.add('active');
                    const tabId = button.getAttribute('data-tab');
                    const targetContent = document.getElementById(`tab-modal-${tabId}`);
                    
                    if (targetContent) {
                        targetContent.classList.add('active');
                        console.log('Pestaña activada:', tabId);
                    } else {
                        console.error('No se encontró el contenido de la pestaña:', `tab-modal-${tabId}`);
                    }
                    
                    // Si se abre la pestaña de áreas, cargar datos
                    if (tabId === 'areas') {
                        cargarAreasParaReporte();
                    }
                });
            });
            
            console.log('Pestañas del modal inicializadas');
        }
        
         //Cargar áreas notificadas y disponibles para el reporte actual
        async function cargarAreasParaReporte() {
            const idReporte = document.getElementById('seguimiento_id_reporte').value;
            
            if (!idReporte) {
                console.error('No hay ID de reporte seleccionado');
                return;
            }
            
            console.log('Cargando áreas para reporte:', idReporte);
            
            try {
                // Cargar áreas ya notificadas
                const respNotificadas = await fetch(`/api/reporte/${idReporte}/areas-notificadas`);
                const dataNotificadas = await respNotificadas.json();
                
                if (dataNotificadas.success) {
                    mostrarAreasNotificadas(dataNotificadas.departamentos);
                }
                
                // Cargar áreas disponibles
                const respDisponibles = await fetch(`/api/reporte/${idReporte}/areas-disponibles`);
                const dataDisponibles = await respDisponibles.json();
                
                if (dataDisponibles.success) {
                    mostrarAreasDisponibles(dataDisponibles.departamentos);
                }
            } catch (error) {
                console.error('Error cargando áreas:', error);
                mostrarToast('Error al cargar las áreas. Intenta nuevamente.', 'error');
            }
        }
        
         //Renderizar la lista de áreas ya notificadas
        function mostrarAreasNotificadas(departamentos) {
            const container = document.getElementById('areasNotificadasList');
            
            if (!departamentos || departamentos.length === 0) {
                container.innerHTML = '<em class="nd">No hay áreas notificadas</em>';
                return;
            }
            
            const ul = document.createElement('ul');
            ul.className = 'lista-areas';
            
            departamentos.forEach(dept => {
                const li = document.createElement('li');
                li.textContent = dept.nombre;
                ul.appendChild(li);
            });
            
            container.innerHTML = '';
            container.appendChild(ul);
            
            console.log(`${departamentos.length} áreas notificadas mostradas`);
        }
        
         //(Renderizar los checkboxes de áreas disponibles para agregar
        
        function mostrarAreasDisponibles(departamentos) {
            const container = document.getElementById('areasDisponiblesGrid');
            
            if (!departamentos || departamentos.length === 0) {
                container.innerHTML = '<p class="sin-areas">No hay áreas adicionales disponibles para agregar.</p>';
                document.getElementById('btnAgregarAreas').disabled = true;
                return;
            }
            
            container.innerHTML = '';
            
            // Calcular punto medio para dividir en dos columnas
            const total = departamentos.length;
            const puntoMedio = Math.ceil(total / 2);
            
            // Configurar grid con número de filas
            container.style.gridTemplateRows = `repeat(${puntoMedio}, auto)`;
            container.style.gridAutoFlow = 'column';
            
            // Función para crear checkbox
            function crearCheckbox(dept) {
                const item = document.createElement('div');
                item.className = 'area-checkbox-item';
                item.innerHTML = `
                    <input type="checkbox" id="area_${dept.id}" value="${dept.id}" class="area-checkbox">
                    <label for="area_${dept.id}">${esc(dept.nombre)}</label>
                `;
                
                // Click en el div también marca/desmarca el checkbox
                item.addEventListener('click', (e) => {
                    if (e.target.tagName !== 'INPUT' && e.target.tagName !== 'LABEL') {
                        const checkbox = item.querySelector('input[type="checkbox"]');
                        checkbox.checked = !checkbox.checked;
                    }
                });
                
                return item;
            }
            
            // Renderizar todos los departamentos en orden
            departamentos.forEach(dept => {
                container.appendChild(crearCheckbox(dept));
            });
            
            document.getElementById('btnAgregarAreas').disabled = false;
            console.log(` ${departamentos.length} áreas disponibles mostradas en 2 columnas`);
        }
        
         //Enviar las áreas seleccionadas al backend
        async function agregarAreasAlReporte() {
            const idReporte = document.getElementById('seguimiento_id_reporte').value;
            const checkboxes = document.querySelectorAll('.area-checkbox:checked');
            
            if (checkboxes.length === 0) {
                mostrarToast('Selecciona al menos un área', 'warning');
                return;
            }
            
            const departamentosIds = Array.from(checkboxes).map(cb => parseInt(cb.value));
            
            console.log('Enviando áreas al reporte:', idReporte);
            console.log('Departamentos:', departamentosIds);
            
            try {
                const response = await fetch(`/api/reporte/${idReporte}/agregar-areas`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        departamentos: departamentosIds
                    })
                });
                
                const data = await response.json();
                
                if (data.success) {
                    mostrarToast(`${data.areas_agregadas} área(s) agregada(s) correctamente`, 'success');
                    
                    // Cerrar modal y recargar seguimientos
                    document.getElementById('modalSeguimiento').classList.remove('show');
                    cargarSeguimientos();
                } else {
                    mostrarToast('Error: ' + data.error, 'error');
                }
            } catch (error) {
                console.error('Error agregando áreas:', error);
                mostrarToast('Error al agregar áreas. Intenta nuevamente.', 'error');
            }
        }
        
        // INICIALIZACIÓN
        // ==============
        document.addEventListener('DOMContentLoaded', function() {
            console.log('DOM cargado');
            
            setupTabs();
            // ⭐ NUEVO: Cargar departamentos responsables para filtros
            cargarDepartamentosResponsables();
            
            // EVENT LISTENERS DE PESTAÑAS
            // ===========================
            function setupTabs() {
                console.log('Configurando pestañas...');

                // Pestaña 1: Reportes Notificados
                const tabReportes = document.getElementById('tab-btn-reportes');
                if (tabReportes) {
                    tabReportes.addEventListener('click', function() {
                        console.log('Click en pestaña Reportes Notificados');
                        cambiarTab('reportes');
                    });
                }

                // Pestaña 2: Seguimiento de Reportes
                const tabSeguimiento = document.getElementById('tab-btn-seguimiento');
                if (tabSeguimiento) {
                    tabSeguimiento.addEventListener('click', function() {
                        console.log('Click en pestaña Seguimiento');
                        cambiarTab('seguimiento');
                    });
                }

                // Pestaña 3: Seguimientos Notificados
                const tabNotificados = document.getElementById('tab-btn-notificados');
                if (tabNotificados) {
                    tabNotificados.addEventListener('click', function() {
                        console.log('Click en pestaña Seguimientos Notificados');
                        cambiarTab('notificados');
                    });
                }

                console.log('Pestañas configuradas');
            }

            function cambiarTab(nombreTab) {
                console.log(`Cambiando a pestaña: ${nombreTab}`);

                // Remover todas las clases active
                document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
                document.querySelectorAll('.content-section').forEach(s => s.classList.remove('active'));

                // Activar pestaña y contenido correspondiente
                if (nombreTab === 'reportes') {
                    document.getElementById('tab-btn-reportes').classList.add('active');
                    document.getElementById('tab-reportes').classList.add('active');
                    cargarReportes();
                } else if (nombreTab === 'seguimiento') {
                    document.getElementById('tab-btn-seguimiento').classList.add('active');
                    document.getElementById('tab-seguimiento').classList.add('active');
                    cargarSeguimientos();
                } else if (nombreTab === 'notificados') {
                    document.getElementById('tab-btn-notificados').classList.add('active');
                    document.getElementById('tab-notificados').classList.add('active');
                    cargarSeguimientosNotificados();
                }

                console.log(`Pestaña ${nombreTab} activada`);
            }
            
            // Cerrar modal
            document.getElementById('btnCerrarModal').addEventListener('click', cerrarModal);
            document.getElementById('modalSeguimiento').addEventListener('click', function(e) {
                if (e.target === this) cerrarModal();
            });
            
            // Upload area
            document.getElementById('fileUploadArea').addEventListener('click', function(e) {
                if (e.target.id === 'seguimiento_archivos') return;
                document.getElementById('seguimiento_archivos').click();
            });
            document.getElementById('fileUploadArea').addEventListener('keydown', function(e) {
                if (e.key === 'Enter' || e.key === ' ') {
                    e.preventDefault();
                    document.getElementById('seguimiento_archivos').click();
                }
            });
            
            // Preview archivos
            document.getElementById('seguimiento_archivos').addEventListener('change', function(e) {
                const files = Array.from(e.target.files);
                if (files.length > 3) {
                    mostrarToast('Máximo 3 archivos', 'error');
                    e.target.value = '';
                    return;
                }
                document.getElementById('archivos_preview').innerHTML = files.map(f => `
                    <span class="sg-chip">${SAGA.icono('paperclip')}${esc(f.name)}</span>
                `).join('');
            });
            
            // Form submit
            document.getElementById('formSeguimiento').addEventListener('submit', async function(e) {
                e.preventDefault();
                console.log('Enviando seguimiento...');

                const formData = new FormData();
                formData.append('id_reporte', document.getElementById('seguimiento_id_reporte').value);
                formData.append('id_departamento', DEPARTAMENTO_ID);
                const estadoElegido = document.getElementById('seguimiento_estado').value;
                formData.append('estado', estadoElegido);

                // Descripción es opcional, salvo para "No requiere atención"
                const descripcion = document.getElementById('seguimiento_descripcion').value.trim();
                if (estadoElegido === 'E') {
                    const original = document.getElementById('seguimiento_folio_original').value.trim().toUpperCase();
                    if (!/^RSM-\d+$/.test(original)) {
                        mostrarToast('Escribe el folio del reporte original, por ejemplo RSM-22', 'error');
                        document.getElementById('seguimiento_folio_original').focus();
                        return;
                    }
                    formData.append('folio_original', original);
                }
                if (estadoElegido === 'F' && descripcion.length < 10) {
                    mostrarToast('Explica por qué no requiere atención (mínimo 10 caracteres)', 'error');
                    document.getElementById('seguimiento_descripcion').focus();
                    return;
                }
                if (descripcion) {
                    formData.append('descripcion', descripcion);
                }

                // Fecha del evento
                const fechaEvento = document.getElementById('seguimiento_fecha_evento').value;
                if (fechaEvento) {
                    // Convertir a formato MySQL datetime (YYYY-MM-DD 00:00:00)
                    formData.append('fecha_evento', `${fechaEvento} 00:00:00`);
                }
                // Si no se proporciona fecha, el backend usará la fecha actual

                const archivos = document.getElementById('seguimiento_archivos').files;
                for (let i = 0; i < archivos.length; i++) {
                    formData.append('archivos_seguimiento', archivos[i]);
                }

                const btnEnviar = document.getElementById('btnEnviarSeguimiento');
                btnEnviar.disabled = true;

                try {
                    // Si hay sesión, se envía para registrar quién hizo el movimiento
                    const token = SMS.token();
                    const response = await fetch('/api/seguimiento/crear', {
                        method: 'POST',
                        headers: token ? { Authorization: 'Bearer ' + token } : {},
                        body: formData
                    });

                    const data = await response.json();
                    console.log('Respuesta completa:', data);
                    console.log('Folio generado:', data.folio);
                    console.log('Número secuencial:', data.numero_secuencial);
                    
                    if (data.success) {
                        mostrarToast(`Seguimiento ${data.folio} creado exitosamente`, 'success');
                        console.log('Folio generado:', data.folio);
                        cerrarModal();
                        cargarSeguimientos();
                    } else {
                        throw new Error(data.error);
                    }
                } catch (error) {
                    console.error('Error:', error);
                    mostrarToast('Error: ' + error.message, 'error');
                } finally {
                    btnEnviar.disabled = false;
                }
            });
            
            //EVENT LISTENERS PARA BOTONES DE FILTROS
            
            // Pestaña Reportes Notificados
            const btnFiltrarReportes = document.getElementById('btnFiltrarReportes');
            const btnLimpiarReportes = document.getElementById('btnLimpiarReportes');
            const filtroOrden = document.getElementById('filtroOrden');
            
            if (btnFiltrarReportes) {
                btnFiltrarReportes.addEventListener('click', aplicarFiltrosReportes);
            }
            if (btnLimpiarReportes) {
                btnLimpiarReportes.addEventListener('click', limpiarFiltrosReportes);
            }
            if (filtroOrden) {
                filtroOrden.addEventListener('change', function() {
                    console.log('Ordenamiento reportes cambiado a:', this.value);
                    cargarReportes();
                });
            }
            
            // Pestaña Seguimiento de Reportes
            const btnFiltrarSeguimientos = document.getElementById('btnFiltrarSeguimientos');
            const btnLimpiarSeguimientos = document.getElementById('btnLimpiarSeguimientos');
            const filtroSegOrden = document.getElementById('filtro_seg_orden');
            
            if (btnFiltrarSeguimientos) {
                btnFiltrarSeguimientos.addEventListener('click', aplicarFiltrosSeguimientos);
            }
            if (btnLimpiarSeguimientos) {
                btnLimpiarSeguimientos.addEventListener('click', limpiarFiltrosSeguimientos);
            }
            if (filtroSegOrden) {
                filtroSegOrden.addEventListener('change', function() {
                    console.log('Ordenamiento seguimientos cambiado a:', this.value);
                    cargarSeguimientos();
                });
            }
            
            // Pestaña Seguimientos Notificados
            const btnFiltrarNotificados = document.getElementById('btnFiltrarNotificados');
            const btnLimpiarNotificados = document.getElementById('btnLimpiarNotificados');
            const filtroNotifOrden = document.getElementById('filtro_notif_orden');
            
            if (btnFiltrarNotificados) {
                console.log('Botón Filtrar Notificados encontrado');
                btnFiltrarNotificados.addEventListener('click', function() {
                    console.log('Click en Filtrar Notificados');
                    aplicarFiltrosNotificados();
                });
            } else {
                console.debug('Pestaña de notificados deshabilitada: sin btnFiltrarNotificados');
            }
            
            if (btnLimpiarNotificados) {
                console.log('Botón Limpiar Notificados encontrado');
                btnLimpiarNotificados.addEventListener('click', function() {
                    console.log('Click en Limpiar Notificados');
                    limpiarFiltrosNotificados();
                });
            } else {
                console.debug('Pestaña de notificados deshabilitada: sin btnLimpiarNotificados');
            }
            
            if (filtroNotifOrden) {
                console.log('Select Orden Notificados encontrado');
                filtroNotifOrden.addEventListener('change', function() {
                    console.log('Ordenamiento notificados cambiado a:', this.value);
                    cargarSeguimientosNotificados();
                });
            } else {
                console.debug('Pestaña de notificados deshabilitada: sin filtroNotifOrden');
            }
            
            console.log('Event listeners configurados');
            
            // Cargar seguimientos inicialmente 
            console.log('Cargando seguimientos iniciales...');
            setTimeout(() => {
                console.log('Ejecutando cargarSeguimientos después de 100ms...');
                cargarSeguimientos();
            }, 100);
            console.log('Inicialización completa');
            
            // Inicializar pestañas del modal
            inicializarPestañasModal();
            
            // Event listener para el botón de agregar áreas
            const btnAgregarAreas = document.getElementById('btnAgregarAreas');
            if (btnAgregarAreas) {
                btnAgregarAreas.addEventListener('click', agregarAreasAlReporte);
            }
        });
    </script>
</body>
</html>