        function cargarBorrador() {
            const borrador = localStorage.getItem('rsm_borrador');
            if (borrador) {
                const data = JSON.parse(borrador);
                const ahora = Date.now();
                const dosHoras = 2 * 60 * 60 * 1000;
                
                // Si el borrador tiene menos de 2 horas
                if (ahora - data.timestamp < dosHoras) {
                    if (confirm('Se encontró un borrador guardado. ¿Desea restaurarlo?')) {
                        document.getElementById('nombre').value = data.nombre || '';
                        document.getElementById('telefono').value = data.telefono || '';
                        if (data.area) {
                            const sel = document.getElementById('area');
                            sel.value = data.area;
                            if (sel.value !== data.area) sel.dataset.pendiente = data.area;
                            document.getElementById('area_otra').value = data.area_otra || '';
                            document.getElementById('area_otra').hidden = data.area !== '__otra';
                        }
                        document.getElementById('cargo').value = data.cargo || '';
                        document.getElementById('tipo_problema').value = data.tipo_problema || '';
                        document.getElementById('tipo_problema_otro').value = data.tipo_problema_otro || '';
                        document.getElementById('lugar').value = data.lugar || '';
                        document.getElementById('descripcion').value = data.descripcion || '';
                        if (data.tipo_reporte) {
                            var radio = document.querySelector('input[name="tipo_reporte"][value="' + CSS.escape(data.tipo_reporte) + '"]');
                            if (radio) radio.checked = true;
                        }
                        CAMPOS_EXTRA.forEach(function (id) {
                            if (data.extra && data.extra[id]) document.getElementById(id).value = data.extra[id];
                        });
                        if (window.SAGABuscable) SAGABuscable.sincronizar();
                        ESCALAS.forEach(function (par) { describirEscala(par[0], par[1]); });
                        document.getElementById('sugerencia_counter').textContent = document.getElementById('sugerencia_prevencion').value.length;

                        // Restaurar departamentos
                        data.departamentos.forEach(id => {
                            const checkbox = document.getElementById(`dept_${id}`);
                            if (checkbox) {
                                checkbox.checked = true;
                                actualizarSeleccionDepartamento(id, true);
                            }
                        });
                        
                        // Actualizar contadores
                        document.getElementById('lugar_counter').textContent = data.lugar.length;
                        document.getElementById('descripcion_counter').textContent = data.descripcion.length;
                        
                        mostrarToast('Borrador restaurado', 'success');
                    } else {
                        localStorage.removeItem('rsm_borrador');
                    }
                } else {
                    localStorage.removeItem('rsm_borrador');
                }
            }
        }
        
