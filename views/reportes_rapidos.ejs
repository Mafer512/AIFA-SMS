        function configurarToggleWhatsApp() {
            const btnToggle = document.getElementById('btnToggleWhatsApp');
            const collapsibleArea = document.getElementById('whatsappCollapsibleArea');
            const toggleIcon = btnToggle.querySelector('.toggle-icon');
            
            // Remover event listeners anteriores si existen
            const newBtnToggle = btnToggle.cloneNode(true);
            btnToggle.parentNode.replaceChild(newBtnToggle, btnToggle);
            
            newBtnToggle.addEventListener('click', function() {
                const isHidden = collapsibleArea.style.display === 'none';
                
                if (isHidden) {
                    collapsibleArea.style.display = 'block';
                    const newToggleIcon = this.querySelector('.toggle-icon');
                    newToggleIcon.textContent = '▲';
                    newToggleIcon.classList.add('expanded');
                } else {
                    collapsibleArea.style.display = 'none';
                    const newToggleIcon = this.querySelector('.toggle-icon');
                    newToggleIcon.textContent = '▼';
                    newToggleIcon.classList.remove('expanded');
                }
            });
        }

