        //Generar checkboxes para todos los departamentos
        function generarCheckboxesDepartamentos() {
            const containerResp = document.getElementById('departamentosResponsablesContainer');
            // const containerNotif = document.getElementById('departamentosNotificadosContainer');
            
            if (!containerResp) {
                console.error(' Contenedor de checkboxes no encontrado');
                return;
            }
            
            // Limpiar contenedor
            containerResp.innerHTML = '';
            // containerNotif.innerHTML = '';
            
            // Calcular punto medio para dividir en dos columnas
            const total = todosDepartamentos.length;
            const puntoMedio = Math.ceil(total / 2);
            
            // Dividir en dos grupos
            const primeraColumna = todosDepartamentos.slice(0, puntoMedio);
            const segundaColumna = todosDepartamentos.slice(puntoMedio);
            
            // Crear contenedores de columna para RESPONSABLES
            const colResp1 = document.createElement('div');
            colResp1.style.display = 'flex';
            colResp1.style.flexDirection = 'column';
            colResp1.style.gap = '10px';
            
            const colResp2 = document.createElement('div');
            colResp2.style.display = 'flex';
            colResp2.style.flexDirection = 'column';
            colResp2.style.gap = '10px';
            
            // Crear contenedores de columna para NOTIFICADOS
            const colNotif1 = document.createElement('div');
            colNotif1.style.display = 'flex';
            colNotif1.style.flexDirection = 'column';
            colNotif1.style.gap = '10px';
            
            const colNotif2 = document.createElement('div');
            colNotif2.style.display = 'flex';
            colNotif2.style.flexDirection = 'column';
            colNotif2.style.gap = '10px';
            
            // Llenar primera columna
            primeraColumna.forEach(dept => {
                colResp1.appendChild(crearCheckboxDepartamento(dept, 'responsables'));
                colNotif1.appendChild(crearCheckboxDepartamento(dept, 'notificados'));
            });
            
            // Llenar segunda columna
            segundaColumna.forEach(dept => {
                colResp2.appendChild(crearCheckboxDepartamento(dept, 'responsables'));
                colNotif2.appendChild(crearCheckboxDepartamento(dept, 'notificados'));
            });
            
            // Agregar columnas a los contenedores
            containerResp.appendChild(colResp1);
            containerResp.appendChild(colResp2);
            const containerNotif = document.getElementById('departamentosNotificadosContainer');
            if (containerNotif) {
                containerNotif.appendChild(colNotif1);
                containerNotif.appendChild(colNotif2);
            }
            
            console.log('Checkboxes generados');
        }
        
        //Crear elemento checkbox para un departamento
        function crearCheckboxDepartamento(dept, tipo) {
            const label = document.createElement('label');
            label.className = 'checkbox-item';
            label.id = `${tipo}_${dept.codigo}`;
            
            const checkbox = document.createElement('input');
            checkbox.type = 'checkbox';
            checkbox.name = `departamentos_${tipo}[]`;
            checkbox.value = dept.codigo;
            checkbox.id = `chk_${tipo}_${dept.codigo}`;
            
            // SIN ICONO - Solo texto
            const labelText = document.createElement('span');
            labelText.className = 'checkbox-label';
            labelText.textContent = dept.nombre;
            
            label.appendChild(checkbox);
            label.appendChild(labelText);
            
            return label;
        }
        
