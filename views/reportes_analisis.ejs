<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Análisis estadístico · S.A.G.A. AIFA</title>
<%- include('partials/head') %>
    <script src="/js/sms-series.js"></script>
    <script src="/js/sms-graficas.js"></script>
    <script src="/js/sms-analisis.js"></script>
    <style>
        .barra-filtros { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 12px; }
        .barra-filtros .sg-field { min-width: 150px; flex: 1 1 160px; }
        .barra-filtros .sg-field--rango { flex: 2 1 300px; }
        .barra-filtros .acciones { display: flex; gap: 8px; }
        .graficas { margin-top: 20px; }
        .zona-graficas { transition: opacity .2s ease; }
        .zona-graficas.is-cargando { opacity: .5; }
        .aviso-riesgo { margin-top: 14px; }
        .niveles-riesgo { margin-top: 18px; }
        .resumen-graf { margin: -4px 0 14px; font-size: 14px; color: var(--n700); }
        .resumen-graf b { color: var(--n900); font-weight: 600; }
    </style>
</head>
<body>
<%- include('partials/appbar', {
    enlaces: [
        { href: '/reportes-rapidos', texto: 'Nuevo reporte', icono: 'file-plus', estilo: 'btn-ghost' },
        { href: '/login', texto: 'Acceso', icono: 'login', estilo: 'btn-secondary' }
    ]
}) %>

    <main class="sg-main">
        <div class="sg-wrap">
            <header class="sg-pagehead">
                <span class="sg-kicker">Seguridad operacional · SMS</span>
                <h1>Análisis estadístico de hallazgos</h1>
                <p>Comportamiento de los reportes en el tiempo, desempeño por área, recurrencias, indicadores SPI y consistencia de los datos.</p>
            </header>

<%- include('partials/sms-nav', { actual: 'analisis' }) %>

            <!-- Filtros: una sola fila sobre todo lo que afectan -->
            <section class="sg-card" aria-labelledby="tFiltros">
                <div class="sg-card__body">
                    <h2 class="sr-only" id="tFiltros">Filtros del análisis</h2>
                    <div class="presets" role="group" aria-label="Periodo">
                        <button type="button" class="preset" data-preset="hoy" aria-pressed="false">Hoy</button>
                        <button type="button" class="preset" data-preset="ayer" aria-pressed="false">Ayer</button>
                        <button type="button" class="preset" data-preset="7" aria-pressed="false">Últimos 7 días</button>
                        <button type="button" class="preset" data-preset="30" aria-pressed="false">Últimos 30 días</button>
                        <button type="button" class="preset" data-preset="mes" aria-pressed="false">Mes actual</button>
                        <button type="button" class="preset" data-preset="mes_anterior" aria-pressed="false">Mes anterior</button>
                        <button type="button" class="preset" data-preset="90" aria-pressed="false">Últimos 90 días</button>
                        <button type="button" class="preset" data-preset="anio" aria-pressed="false">Este año</button>
                        <button type="button" class="preset" data-preset="todo" aria-pressed="true">Todo el historial</button>
                    </div>
                    <form class="barra-filtros" id="formFiltros" novalidate>
                        <div class="sg-field sg-field--rango">
                            <label for="f_desde">Periodo personalizado</label>
                            <div class="rango">
                                <input type="date" id="f_desde" name="desde" aria-label="Desde">
                                <input type="date" id="f_hasta" name="hasta" aria-label="Hasta">
                            </div>
                        </div>
                        <div class="sg-field">
                            <label for="f_area">Área</label>
                            <select id="f_area" name="area"><option value="">Todas</option></select>
                        </div>
                        <div class="sg-field">
                            <label for="f_categoria">Categoría</label>
                            <select id="f_categoria" name="categoria"><option value="">Todas</option></select>
                        </div>
                        <div class="agrupar">
                            <span id="lblAgrupar">Agrupar por</span>
                            <div class="segm" role="group" aria-labelledby="lblAgrupar" data-tip="Agrupación de las gráficas por fecha. Automático: por día hasta 2 meses, por semana hasta 6 meses y por mes en periodos más largos.">
                                <button type="button" data-gran="auto" aria-pressed="true">Automático</button>
                                <button type="button" data-gran="dia" aria-pressed="false">Día</button>
                                <button type="button" data-gran="semana" aria-pressed="false">Semana</button>
                                <button type="button" data-gran="mes" aria-pressed="false">Mes</button>
                            </div>
                        </div>
                        <div class="acciones">
                            <button type="button" class="btn btn-secondary" id="btnRestablecer"><svg class="ic" aria-hidden="true"><use href="/img/icons.svg#i-refresh"/></svg>Restablecer</button>
                            <div class="menu">
                                <button type="button" class="btn btn-secondary" data-menu aria-haspopup="true" aria-expanded="false"><svg class="ic" aria-hidden="true"><use href="/img/icons.svg#i-download"/></svg>Exportar</button>
                                <div class="menu__panel" hidden>
                                    <div class="menu__t">Con los filtros activos</div>
                                    <button type="button" class="menu__item" id="expPdf"><svg class="ic" aria-hidden="true"><use href="/img/icons.svg#i-print"/></svg><span>Informe ejecutivo (PDF)<small>Indicadores, comparativo, áreas, SPI y gráficas</small></span></button>
                                    <button type="button" class="menu__item" id="expExcel"><svg class="ic" aria-hidden="true"><use href="/img/icons.svg#i-table"/></svg><span>Excel (.xlsx)<small>Listado y resumen</small></span></button>
                                </div>
                            </div>
                        </div>
                    </form>
                    <div class="activos" id="filtrosActivos" hidden>
                        <span class="activos__t">Filtros activos:</span>
                        <span id="chipsActivos" style="display:contents"></span>
                    </div>
                </div>
            </section>

            <div class="zona-graficas" id="zona">
                <!-- Indicadores -->
                <div class="sg-kpis sg-kpis--5" style="margin-top:20px" id="kpis">
                    <div class="sg-kpi" data-tip="Cada reporte cuenta una sola vez aunque esté asignado a varias áreas"><div class="l">Total de reportes</div><div class="n" id="k-total">—</div><div class="d" id="k-total-d">&nbsp;</div></div>
                    <div class="sg-kpi" data-tip="Cerrados = Resuelto + Duplicado + No requiere atención"><div class="l">Reportes cerrados</div><div class="n" id="k-cerrados">—</div><div class="d" id="k-cerrados-d">&nbsp;</div></div>
                    <div class="sg-kpi" data-tip="Mediana del tiempo entre el reporte y su registro como Resuelto. Duplicado y No requiere atención no cuentan como resoluciones."><div class="l">Tiempo de resolución</div><div class="n" id="k-tiempo">—</div><div class="d" id="k-tiempo-d">&nbsp;</div></div>
                    <div class="sg-kpi"><div class="l">Alto riesgo</div><div class="n" id="k-alto">—</div><div class="d" id="k-alto-d">&nbsp;</div></div>
                    <div class="sg-kpi"><div class="l">Vencidos</div><div class="n" id="k-vencidos">—</div><div class="d" id="k-vencidos-d">&nbsp;</div></div>
                </div>

                <!-- Gráficas. Todas usan los mismos filtros de arriba y los datos de /api/sms/analisis
                     (agregados en la base). Cada tarjeta: restablecer vista, PNG y vista de tabla. -->
<%
    const tarjetasGraf = [
        { id: 'evolucion', ancha: true, icono: 'chart-line', titulo: 'Evolución de reportes',
          sub: 'Recibidos por fecha del reporte y cerrados por fecha de cierre. Toca un periodo para filtrarlo; arrastra para acercar.', nota: true },
        { id: 'periodos', ancha: true, icono: 'chart-bar', titulo: 'Reportes por periodo y estatus',
          sub: 'Estatus vigente de los reportes recibidos en cada periodo. Toca una columna para filtrar ese periodo.', resumen: true },
        { id: 'flujo', icono: 'activity', titulo: 'Flujo acumulado',
          sub: 'Recibidos y cerrados acumulados; la distancia entre ambas curvas son los reportes pendientes.', nota: true },
        { id: 'estatus', icono: 'pie', titulo: 'Distribución por estatus',
          sub: 'Estatus vigente de cada reporte. Toca un estatus para filtrar.' },
        { id: 'horas', icono: 'clock', titulo: 'Concentración por hora del día',
          sub: 'Hora en que se registró cada reporte.', nota: true },
        { id: 'tendencia', icono: 'trend', titulo: 'Tendencia de resolución',
          sub: 'Días promedio para resolver, por mes de resolución' },
        { id: 'areas', icono: 'building', titulo: 'Hallazgos por área',
          sub: 'Áreas notificadas o responsables (15 con más reportes). Toca un área para filtrar.' },
        { id: 'categorias', icono: 'tag', titulo: 'Categorías más frecuentes',
          sub: 'Las 10 categorías con más reportes. Toca una para filtrar.' },
        { id: 'tipos', ancha: true, icono: 'list', titulo: 'Reportes por tipo',
          sub: 'Reportes voluntarios (prevenir) y obligatorios (eventos que ya causaron afectación), según el numeral 5.2.1 del Manual SMS. Toca un tipo para filtrar.', nota: true }
    ];
    function acciones(id, conVista) { %>
                            <div class="viz-acciones">
<%      if (conVista) { %>
                                <button type="button" class="btn btn-ghost btn-sm" data-restablecer-viz="g-<%= id %>" hidden data-tip="Quitar el zoom y mostrar todas las series"><svg class="ic" aria-hidden="true"><use href="/img/icons.svg#i-refresh"/></svg>Restablecer vista</button>
<%      } %>
                                <button type="button" class="btn btn-ghost btn-sm btn-icon" data-png data-tip="Descargar como imagen PNG (con título y leyenda)" aria-label="Descargar la gráfica como imagen PNG"><svg class="ic" aria-hidden="true"><use href="/img/icons.svg#i-download"/></svg></button>
                                <button type="button" class="btn btn-ghost btn-tabla" data-tabla="t-<%= id %>" aria-expanded="false"><svg class="ic" aria-hidden="true"><use href="/img/icons.svg#i-table"/></svg><span class="lbl">Ver tabla</span></button>
                            </div>
<%  }
%>
                <div class="graficas">
<% tarjetasGraf.forEach(function (t) { %>
                    <section class="sg-card grafica<%= t.ancha ? ' ancha' : '' %>" aria-labelledby="tt-<%= t.id %>">
                        <div class="sg-card__head">
                            <h2 class="sg-card__title" id="tt-<%= t.id %>"><svg class="ic" aria-hidden="true"><use href="/img/icons.svg#i-<%= t.icono %>"/></svg><span><%= t.titulo %><span class="sub"><%= t.sub %></span></span></h2>
<%     acciones(t.id, ['evolucion', 'periodos', 'flujo', 'areas'].indexOf(t.id) >= 0); %>
                        </div>
                        <div class="sg-card__body">
<%     if (t.resumen) { %>                            <p class="resumen-graf" id="resumenMensual"></p>
<%     } %>
<%     if (t.nota) { %>                            <p class="nota-graf" id="nota-<%= t.id %>" hidden></p>
<%     } %>
                            <div class="viz" id="g-<%= t.id %>"><span class="skel viz-skel" aria-hidden="true"></span></div>
                            <div class="viz-tabla" id="t-<%= t.id %>" hidden></div>
                        </div>
                    </section>
<% }); %>

                    <section class="sg-card grafica ancha" aria-labelledby="tt-riesgo">
                        <div class="sg-card__head">
                            <h2 class="sg-card__title" id="tt-riesgo"><svg class="ic" aria-hidden="true"><use href="/img/icons.svg#i-shield"/></svg><span>Clasificación por nivel de riesgo<span class="sub">Reportes evaluados en la matriz de probabilidad × severidad. Toca un nivel para filtrar.</span></span></h2>
<% acciones('riesgo', false); %>
                        </div>
                        <div class="sg-card__body">
                            <div class="viz" id="g-riesgo"><span class="skel viz-skel" aria-hidden="true"></span></div>
                            <div class="viz niveles-riesgo" id="g-niveles"></div>
                            <div class="viz-tabla" id="t-riesgo" hidden></div>
                            <div class="sg-banner warn aviso-riesgo" id="avisoMatriz" hidden>
                                <svg class="ic" aria-hidden="true"><use href="/img/icons.svg#i-warn"/></svg>
                                <span>La matriz de riesgo tiene los criterios del Manual SMS (numeral 5.3), pero aún no se confirma en el sistema.</span>
                            </div>
                        </div>
                    </section>
                </div>

                <!-- Comparación entre periodos -->
                <div class="seccion-t">
                    <div>
                        <h2><svg class="ic" aria-hidden="true"><use href="/img/icons.svg#i-trend"/></svg>Comparación entre periodos</h2>
                        <p id="compNota">Compara el periodo seleccionado con el anterior de igual duración o con el mismo periodo del año anterior.</p>
                    </div>
                    <div class="periodo-sel">
                        <span id="lblModo">Comparar con</span>
                        <div class="segm" role="group" aria-labelledby="lblModo">
                            <button type="button" data-modo="anterior" aria-pressed="true">Periodo anterior</button>
                            <button type="button" data-modo="anio" aria-pressed="false">Año anterior</button>
                        </div>
                    </div>
                </div>
                <section class="sg-card" aria-label="Comparación entre periodos"><div class="sg-card__body" id="comparativo"><span class="skel"></span><span class="skel skel--media"></span></div></section>

                <!-- SPI -->
                <div class="seccion-t">
                    <div>
                        <h2><svg class="ic" aria-hidden="true"><use href="/img/icons.svg#i-gauge"/></svg>Indicadores de desempeño de seguridad (SPI)</h2>
                        <p id="spiNota">Valores mensuales calculados con los registros; la meta y el nivel de alerta de cada indicador los configura la Gerencia de SMS.</p>
                    </div>
                    <a class="btn btn-ghost btn-sm" href="/admin/spi" id="enlaceSpi"><svg class="ic" aria-hidden="true"><use href="/img/icons.svg#i-settings"/></svg>Configuración de SPI</a>
                </div>
                <div id="spi"><span class="skel"></span></div>

                <!-- Desempeño por área -->
                <div class="seccion-t">
                    <div>
                        <h2><svg class="ic" aria-hidden="true"><use href="/img/icons.svg#i-building"/></svg>Desempeño por área responsable</h2>
                        <p>Reportes donde el área está marcada como responsable. Toca un área para ver sus reportes.</p>
                    </div>
                </div>
                <section class="sg-card" aria-label="Desempeño por área responsable"><div class="sg-card__body" id="desempeno"><span class="skel"></span><span class="skel"></span><span class="skel skel--media"></span></div></section>

                <!-- Recurrencias -->
                <div class="seccion-t">
                    <div>
                        <h2><svg class="ic" aria-hidden="true"><use href="/img/icons.svg#i-repeat"/></svg>Hallazgos recurrentes</h2>
                        <p id="recNota">Categorías y lugares que se repiten.</p>
                    </div>
                </div>
                <div class="recurrencias">
                    <section class="sg-card">
                        <div class="sg-card__head"><h3 class="sg-card__title"><svg class="ic" aria-hidden="true"><use href="/img/icons.svg#i-tag"/></svg>Por categoría</h3></div>
                        <div class="sg-card__body" id="recCategorias"><span class="skel"></span></div>
                    </section>
                    <section class="sg-card">
                        <div class="sg-card__head"><h3 class="sg-card__title"><svg class="ic" aria-hidden="true"><use href="/img/icons.svg#i-pin"/></svg><span id="recLugarT">Por lugar reportado</span></h3></div>
                        <div class="sg-card__body" id="recLugares"><span class="skel"></span></div>
                    </section>
                </div>
                <div class="viz-leyenda" style="margin-top:10px"><span><i style="--c:var(--s1)"></i>Cerrados</span><span><i style="--c:var(--s2)"></i>Abiertos</span></div>

                <!-- Calidad de datos -->
                <div class="seccion-t">
                    <div>
                        <h2><svg class="ic" aria-hidden="true"><use href="/img/icons.svg#i-checklist"/></svg>Consistencia de los datos</h2>
                        <p>Verificación de que las cifras cuadran y de registros que conviene revisar. Considera todos los reportes, sin filtros.</p>
                    </div>
                </div>
                <section class="sg-card" aria-label="Consistencia de los datos"><div class="sg-card__body" id="calidad"><span class="skel"></span></div></section>
            </div>
        </div>
    </main>

<%- include('partials/footer') %>

    <script>
    (function () {
        'use strict';
        var $ = function (id) { return document.getElementById(id); };
        var G = SMSGraficas, SS = SMSSeries;
        var CAMPOS = ['folio', 'q', 'fecha', 'desde', 'hasta', 'area', 'responsable', 'categoria', 'tipo', 'estado', 'riesgo', 'vencimiento'];
        var PRESETS = ['hoy', 'ayer', '7', '30', 'mes', 'mes_anterior', '90', 'anio'];
        var GRANS = ['auto', 'dia', 'semana', 'mes'];
        var filtros = {};
        var gran = 'auto';
        var controlador = null;
        var modoComp = 'anterior';
        var ultimo = null;            // última respuesta de /api/sms/analisis (para reagrupar sin pedirla otra vez)
        var catalogo = { areas: {}, niveles: {}, tipos: { sin_clasificar: 'Sin clasificar' } };
        var A = SMSAnalisis;
        // Mismos 4 grupos de estatus que las tarjetas de la vista general (colores validados)
        var GRUPOS = [
            { clave: 'A', campo: 'nuevos', nombre: 'Nuevos', color: 'var(--g-nuevo)' },
            { clave: 'atencion', campo: 'atencion', nombre: 'En atención', color: 'var(--g-atencion)' },
            { clave: 'D', campo: 'resueltos', nombre: 'Resueltos', color: 'var(--g-resuelto)' },
            { clave: 'sin_accion', campo: 'sin_accion', nombre: 'Cerrados sin acción', color: 'var(--g-sinaccion)' }
        ];
        var ETIQUETAS_FILTRO = { folio: 'Folio', q: 'Palabras', fecha: 'Fecha', responsable: 'Responsable', tipo: 'Tipo de reporte', estado: 'Estatus', riesgo: 'Riesgo', vencimiento: 'Plazo' };
        var VALORES_ESTADO = { A: 'A · Generado', B: 'B · Enterado', C: 'C · En atención', D: 'D · Resuelto', E: 'E · Duplicado', F: 'F · No requiere atención', abiertos: 'Abiertos', cerrados: 'Cerrados', atencion: 'En atención (B y C)', sin_accion: 'Cerrados sin acción (E y F)' };
        var VALORES_RIESGO = { altos: 'Alto riesgo', sin_evaluar: 'Sin evaluar', pendiente_evaluar: 'Pendientes de evaluar' };
        var VALORES_PLAZO = { vencidos: 'Vencidos', proximos: 'Próximos a vencer', en_tiempo: 'En tiempo', con_fecha: 'Con plazo', sin_fecha: 'Sin plazo', cerrado_en_plazo: 'Cerrados en plazo', cerrado_fuera: 'Cerrados fuera de plazo' };

        function leerURL() {
            var p = new URLSearchParams(location.search);
            CAMPOS.forEach(function (c) { var v = p.get(c); if (v) filtros[c] = v; });
            if (GRANS.indexOf(p.get('agrupar')) > 0) gran = p.get('agrupar');
        }
        function qs() {
            var p = new URLSearchParams();
            CAMPOS.forEach(function (c) { if (filtros[c]) p.set(c, filtros[c]); });
            return p;
        }
        function rango(p) {
            if (p === 'todo') return { desde: '', hasta: '' };
            return SMS.rangoPeriodo(p);
        }
        function pintarForm() {
            $('f_desde').value = filtros.fecha || filtros.desde || '';
            $('f_hasta').value = filtros.fecha || filtros.hasta || '';
            $('f_area').value = filtros.area || '';
            $('f_categoria').value = filtros.categoria || '';
            var actual = filtros.fecha || filtros.desde || filtros.hasta ? (filtros.fecha ? null : SMS.periodoActivo(filtros.desde, filtros.hasta, PRESETS)) : 'todo';
            document.querySelectorAll('.preset').forEach(function (b) { b.setAttribute('aria-pressed', b.dataset.preset === actual ? 'true' : 'false'); });
            document.querySelectorAll('[data-gran]').forEach(function (b) { b.setAttribute('aria-pressed', b.dataset.gran === gran ? 'true' : 'false'); });
            var q = qs();
            var qFiltros = q.toString();
            if (gran !== 'auto') q.set('agrupar', gran);
            var qUrl = q.toString();
            history.replaceState(null, '', location.pathname + (qUrl ? '?' + qUrl : ''));
            $('enlaceReportes').href = '/reportes/general' + (qFiltros ? '?' + qFiltros : '');
        }

        async function catalogos() {
            try {
                var d = await SMS.api('/api/sms/catalogos');
                $('f_area').innerHTML = '<option value="">Todas</option>' + d.departamentos.map(function (x) {
                    return '<option value="' + x.id + '">' + SMS.esc(x.nombre) + (x.activo ? '' : ' (inactiva)') + '</option>';
                }).join('');
                $('f_categoria').innerHTML = '<option value="">Todas</option>' + d.categorias.map(function (c) { return '<option>' + SMS.esc(c) + '</option>'; }).join('');
                d.departamentos.forEach(function (x) { catalogo.areas[x.id] = x.nombre; });
                d.niveles.forEach(function (n) { catalogo.niveles[n.clave] = n.nombre; });
                (d.tipos_reporte || []).forEach(function (t) { catalogo.tipos[t.clave] = t.nombre; });
            } catch (e) { /* los filtros quedan con "Todas" */ }
        }

        function kpi(id, html, det) {
            var n = $(id);
            if (html === null) { n.textContent = 'Sin datos'; n.classList.add('nd'); } else { n.innerHTML = html; n.classList.remove('nd'); }
            $(id + '-d').textContent = det || '';
        }

        // ------------------------------------------------ periodos y etiquetas
        var fmtCorta = new Intl.DateTimeFormat('es-MX', { day: 'numeric', month: 'short', timeZone: 'UTC' });
        var fmtDiaSem = new Intl.DateTimeFormat('es-MX', { weekday: 'short', timeZone: 'UTC' });
        var fmtMesLargo = new Intl.DateTimeFormat('es-MX', { month: 'long', year: 'numeric', timeZone: 'UTC' });
        function aUTC(iso) { return new Date(iso + 'T12:00:00Z'); }
        function sinPunto(t) { return t.replace(/\./g, ''); }
        function etiquetaEje(c, g) {
            return g === 'mes' ? SMS.mes(c.clave) : sinPunto(fmtCorta.format(aUTC(c.desde)));
        }
        function tituloCubeta(c, g) {
            if (g === 'dia') return sinPunto(fmtDiaSem.format(aUTC(c.desde))) + ' ' + SMS.fecha(c.desde);
            if (g === 'semana') return 'Semana del ' + SMS.fecha(c.desde) + ' al ' + SMS.fecha(c.hasta) + (c.parcial ? ' (parcial)' : '');
            var m = fmtMesLargo.format(aUTC(c.clave + '-15'));
            return m.charAt(0).toUpperCase() + m.slice(1) + (c.parcial ? ' (del ' + SMS.fecha(c.desde) + ' al ' + SMS.fecha(c.hasta) + ')' : '');
        }
        var NOMBRE_GRAN = { dia: 'día', semana: 'semana', mes: 'mes' };
        function rangoTexto(r) { return r ? (r.desde === r.hasta ? SMS.fecha(r.desde) : SMS.fecha(r.desde) + ' – ' + SMS.fecha(r.hasta)) : 'Todo el historial'; }
        function nota(id, texto) { var n = $(id); if (!n) return; n.textContent = texto || ''; n.hidden = !texto; }

        // Tocar un periodo de una gráfica lo aplica como filtro de fechas
        function filtrarPeriodo(c) {
            filtros.desde = c.desde; filtros.hasta = c.hasta;
            delete filtros.fecha;
            SAGA.toast('Periodo: ' + rangoTexto(c), 'info', { duracion: 2500 });
            cargar();
        }
        // Tocar un elemento ya filtrado quita el filtro (alternar)
        function alternarFiltro(campo, valor) {
            if (String(filtros[campo]) === String(valor)) delete filtros[campo];
            else filtros[campo] = String(valor);
            cargar();
        }

        // Cada gráfica se dibuja por separado: si una falla, las demás se muestran igual
        function seguro(ids, fn) {
            try { fn(); }
            catch (e) {
                if (window.console) console.error('No se pudo dibujar ' + ids.join(', '), e);
                ids.forEach(function (id) { G.vacio($(id), 'No se pudo dibujar la gráfica', e.message, 'crit'); });
            }
        }
        // Un servidor sin reiniciar tras la actualización todavía no envía las series nuevas
        var SIN_SERIES = 'El servidor aún no envía las series por fecha y por hora. Reinicia el servidor del SMS para cargar la versión actual.';
        function faltanSeries(a, campos) { return campos.some(function (k) { return !Array.isArray(a[k]); }); }

        // Gráficas por fecha: se reagrupan en el navegador al cambiar "Agrupar por"
        function pintarTiempo(d) {
            var a = d.analisis, num = SMS.numero;
            var hoy = SMS.diaLocal();
            var vacioTxt = 'Amplía el periodo o quita filtros.';
            if (faltanSeries(a, ['diario', 'cierres_diarios'])) {
                ['g-evolucion', 'g-periodos', 'g-flujo'].forEach(function (id) { G.vacio($(id), 'Gráfica no disponible', SIN_SERIES, 'warn'); });
                ['t-evolucion', 't-periodos', 't-flujo'].forEach(function (id) { $(id).innerHTML = ''; });
                $('resumenMensual').innerHTML = '';
                nota('nota-evolucion', ''); nota('nota-flujo', '');
                return;
            }
            var base = SS.rangoEfectivo(filtros, a.diario, hoy);
            if (!base) {
                ['g-evolucion', 'g-periodos', 'g-flujo'].forEach(function (id) { G.vacio($(id), 'Sin reportes en este periodo', vacioTxt, 'chart-line'); });
                ['t-evolucion', 't-periodos', 't-flujo'].forEach(function (id) { $(id).innerHTML = ''; });
                $('resumenMensual').innerHTML = '';
                nota('nota-evolucion', ''); nota('nota-flujo', '');
                return;
            }
            // Sin fin de periodo elegido, se incluyen los cierres posteriores (hasta hoy)
            var r = filtros.hasta || filtros.fecha ? base : SS.rangoFlujo(base, a.cierres_diarios, hoy);
            var p = SS.periodos(r.desde, r.hasta, gran === 'auto' ? SS.granularidad(r.desde, r.hasta) : gran);
            var g = p.gran;
            var cub = SS.agrupar(a.diario, a.cierres_diarios, p.cubetas);
            var claves = cub.map(function (c) { return c.clave; });
            var porClave = {};
            cub.forEach(function (c) { porClave[c.clave] = c; });
            var eje = function (clave) { return etiquetaEje(porClave[clave], g); };
            var titulos = cub.map(function (c) { return tituloCubeta(c, g); });
            var sinFecha = a.cerrados_sin_fecha > 0 ? ' ' + num(a.cerrados_sin_fecha) + ' reporte(s) cerrados sin registro de cierre no tienen fecha y no aparecen como cerrados.' : '';
            var aviso = gran === 'dia' && g !== 'dia' ? ' El periodo es demasiado largo para verlo por día: se agrupa por semana.' : '';
            var pistaFiltro = 'Clic para filtrar este periodo';

            nota('nota-evolucion', 'Agrupado por ' + NOMBRE_GRAN[g] + ' · ' + rangoTexto(r) + '.' + aviso + sinFecha);
            seguro(['g-evolucion'], function () { G.lineas($('g-evolucion'), {
                etiquetas: claves, formatoX: eje, titulos: titulos, tituloX: 'Periodo',
                descripcion: 'Reportes recibidos y cerrados por ' + NOMBRE_GRAN[g],
                series: [
                    { nombre: 'Recibidos', color: 'var(--g-recibidos)', valores: cub.map(function (c) { return c.recibidos; }) },
                    { nombre: 'Cerrados', color: 'var(--g-cerrados)', valores: cub.map(function (c) { return c.cerrados; }) }
                ],
                interactiva: true, zoom: true,
                alElegir: function (i) { filtrarPeriodo(cub[i]); },
                pista: pistaFiltro + ' · arrastra para acercar',
                tabla: $('t-evolucion'),
                vacioTitulo: 'Sin reportes en este periodo', vacioTexto: vacioTxt
            }); });

            var pct = function (x, y) { return y ? Math.round((x / y) * 100) : 0; };
            var totRec = cub.reduce(function (s, c) { return s + c.recibidos; }, 0);
            var totCer = cub.reduce(function (s, c) { return s + c.resueltos + c.sin_accion; }, 0);
            var pico = cub.reduce(function (m, c) { return c.recibidos > m.recibidos ? c : m; }, { recibidos: -1 });
            $('resumenMensual').innerHTML = totRec
                ? 'Se recibieron <b>' + num(totRec) + ' reportes</b>; <b>' + num(totCer) + ' ya están cerrados</b> (' + pct(totCer, totRec) + ' %) y <b>' + num(totRec - totCer) + ' siguen abiertos</b>.' +
                  (cub.length > 1 ? ' El ' + NOMBRE_GRAN[g] + ' con más reportes: ' + SMS.esc(titulos[cub.indexOf(pico)]) + ' (' + num(pico.recibidos) + ').' : '')
                : '';
            seguro(['g-periodos'], function () { G.columnas($('g-periodos'), {
                etiquetas: claves, formatoX: eje, titulos: titulos,
                descripcion: 'Reportes recibidos por ' + NOMBRE_GRAN[g] + ', divididos por su estatus vigente',
                series: GRUPOS.map(function (x) { return { nombre: x.nombre, color: x.color, valores: cub.map(function (c) { return c[x.campo]; }) }; }),
                interactiva: true,
                alElegir: function (i) { filtrarPeriodo(cub[i]); },
                pista: pistaFiltro,
                detalleCorto: g === 'mes' ? function (i) { var c = cub[i]; return c.recibidos ? pct(c.resueltos + c.sin_accion, c.recibidos) + ' % cerrado' : ''; } : null,
                extraTooltip: function (i) { var c = cub[i]; return c.recibidos ? [{ nombre: 'cerrado (del total)', valor: pct(c.resueltos + c.sin_accion, c.recibidos) + ' %', color: 'transparent' }] : []; },
                tabla: $('t-periodos'),
                encabezadosTabla: ['Periodo', 'Recibidos', 'Nuevos', 'En atención', 'Resueltos', 'Sin acción', '% cerrado'],
                filasTabla: cub.map(function (c, i) { return [titulos[i], num(c.recibidos), num(c.nuevos), num(c.atencion), num(c.resueltos), num(c.sin_accion), pct(c.resueltos + c.sin_accion, c.recibidos) + ' %']; }),
                vacioTitulo: 'Sin reportes en este periodo', vacioTexto: vacioTxt
            }); });

            // Flujo acumulado: los reportes del periodo, seguidos hasta su último cierre
            seguro(['g-flujo'], function () {
            var rf = SS.rangoFlujo(base, a.cierres_diarios, hoy);
            var pf = SS.periodos(rf.desde, rf.hasta, gran === 'auto' ? SS.granularidad(rf.desde, rf.hasta) : gran);
            var ac = SS.acumulado(a.diario, a.cierres_diarios, pf.cubetas);
            var ultimoAc = ac[ac.length - 1];
            nota('nota-flujo', ac.length
