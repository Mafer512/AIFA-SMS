                : '');
            var porClaveF = {};
            pf.cubetas.forEach(function (c) { porClaveF[c.clave] = c; });
            G.lineas($('g-flujo'), {
                etiquetas: ac.map(function (c) { return c.clave; }),
                formatoX: function (clave) { return etiquetaEje(porClaveF[clave], pf.gran); },
                titulos: ac.map(function (c) { return 'Al cierre del ' + SMS.fecha(c.hasta); }),
                tituloX: 'Al cierre de',
                descripcion: 'Reportes recibidos y cerrados acumulados',
                series: [
                    { nombre: 'Recibidos acumulados', color: 'var(--g-recibidos)', valores: ac.map(function (c) { return c.recibidos; }) },
                    { nombre: 'Cerrados acumulados', color: 'var(--g-cerrados)', valores: ac.map(function (c) { return c.cerrados; }) }
                ],
                areas: true, interactiva: true, zoom: true,
                extraTooltip: function (i, ocultas) {
                    return ocultas && ocultas.size ? [] : [{ nombre: 'pendientes (abiertos)', valor: num(ac[i].pendientes), color: 'transparent', separador: true }];
                },
                pista: 'Arrastra para acercar',
                tabla: $('t-flujo'),
                vacioTitulo: 'Sin reportes en este periodo', vacioTexto: vacioTxt
            });
            });
        }

        function pintar(d) {
            ultimo = d;
            var a = d.analisis, i = d.indicadores, num = SMS.numero;
            kpi('k-total', num(i.total), i.abiertos + ' abiertos · ' + i.cerrados + ' cerrados');
            kpi('k-cerrados', i.porcentaje_cerrados == null ? null : num(i.porcentaje_cerrados, 1) + '<small>%</small>', i.total ? i.resueltos + ' resueltos · ' + i.duplicados + ' duplicados · ' + i.no_requiere + ' no requieren' : '');
            kpi('k-tiempo', i.dias_mediana_resolucion == null ? null : SMS.duracionDias(i.dias_mediana_resolucion).replace(/ (min|h|días?)$/, '<small>$1</small>'),
                i.resueltos_con_fecha ? 'Mediana · promedio ' + SMS.duracionDias(i.dias_promedio_resolucion) + ' · ' + i.resueltos_con_fecha + ' resuelto(s)' : 'Sin reportes resueltos');
            kpi('k-alto', i.evaluados ? num(i.alto_riesgo) : null, i.evaluados ? 'De ' + i.evaluados + ' evaluado(s)' : 'Sin evaluaciones de riesgo');
            kpi('k-vencidos', i.con_fecha ? num(i.vencidos) : null, i.con_fecha ? 'De ' + i.con_fecha + ' con fecha compromiso' : 'Sin fechas compromiso');

            seguro(['g-evolucion', 'g-periodos', 'g-flujo'], function () { pintarTiempo(d); });

            // Distribución por estatus: dona con los 4 grupos y su desglose
            seguro(['g-estatus'], function () {
            var est = {};
            a.por_estatus.forEach(function (e) { est[e.estado] = e.n; });
            G.dona($('g-estatus'), {
                partes: [
                    { clave: 'A', nombre: 'Nuevos', valor: est.A || 0, color: 'var(--g-nuevo)', detalle: 'A · Generado' },
                    { clave: 'atencion', nombre: 'En atención', valor: (est.B || 0) + (est.C || 0), color: 'var(--g-atencion)', detalle: 'B · Enterado ' + num(est.B || 0) + ' · C · En atención ' + num(est.C || 0) },
                    { clave: 'D', nombre: 'Resueltos', valor: est.D || 0, color: 'var(--g-resuelto)', detalle: 'D · Resuelto' },
                    { clave: 'sin_accion', nombre: 'Cerrados sin acción', valor: (est.E || 0) + (est.F || 0), color: 'var(--g-sinaccion)', detalle: 'E · Duplicado ' + num(est.E || 0) + ' · F · No requiere ' + num(est.F || 0) }
                ],
                seleccion: ['A', 'atencion', 'D', 'sin_accion'].indexOf(filtros.estado) >= 0 ? filtros.estado : null,
                alElegir: function (p) { alternarFiltro('estado', p.clave); },
                tabla: $('t-estatus'), vacioTitulo: 'Sin reportes con estos filtros', vacioTexto: 'Quita algún filtro para ver la distribución.'
            });
            });

            // Concentración por hora del día
            seguro(['g-horas'], function () {
            if (faltanSeries(a, ['por_hora'])) { G.vacio($('g-horas'), 'Gráfica no disponible', SIN_SERIES, 'warn'); $('t-horas').innerHTML = ''; nota('nota-horas', ''); return; }
            var totalH = a.por_hora.reduce(function (s, h) { return s + h.n; }, 0);
            var picoH = a.por_hora.reduce(function (m, h) { return h.n > m.n ? h : m; }, { n: -1 });
            var hh = function (h) { return (h < 10 ? '0' : '') + h; };
            nota('nota-horas', totalH ? 'Hora con más reportes: ' + hh(picoH.hora) + ':00–' + hh(picoH.hora) + ':59 (' + num(picoH.n) + ', ' + Math.round((picoH.n / totalH) * 100) + ' % del total).' : '');
            G.columnas($('g-horas'), {
                etiquetas: a.por_hora.map(function (h) { return h.hora; }),
                formatoX: function (h) { return hh(h) + ' h'; },
                titulos: a.por_hora.map(function (h) { return hh(h.hora) + ':00 – ' + hh(h.hora) + ':59'; }),
                descripcion: 'Reportes por hora del día en que se registraron',
                series: [{ nombre: 'Reportes', color: 'var(--s1)', valores: a.por_hora.map(function (h) { return h.n; }) }],
                extraTooltip: function (k) { return totalH ? [{ nombre: 'del total', valor: Math.round((a.por_hora[k].n / totalH) * 1000) / 10 + ' %', color: 'transparent' }] : []; },
                alto: 240,
                tabla: $('t-horas'),
                encabezadosTabla: ['Hora', 'Reportes', '% del total'],
                filasTabla: a.por_hora.map(function (h) { return [hh(h.hora) + ':00–' + hh(h.hora) + ':59', num(h.n), (totalH ? Math.round((h.n / totalH) * 1000) / 10 : 0) + ' %']; }),
                vacioTitulo: 'Sin reportes con estos filtros', vacioTexto: 'Quita algún filtro para ver la concentración por hora.'
            });
            });

            seguro(['g-tendencia'], function () {
            var meses = a.mensual.map(function (m) { return m.mes; });
            G.lineas($('g-tendencia'), {
                etiquetas: meses, formatoX: SMS.mes, tituloX: 'Mes',
                descripcion: 'Días promedio de resolución por mes',
                formatoY: function (v) { return SMS.numero(v, 1) + ' d'; },
                series: [{ nombre: 'Días promedio de resolución', color: 'var(--s1)', valores: a.mensual.map(function (m) { return m.dias_promedio_resolucion; }) }],
                tabla: $('t-tendencia'),
                vacioTitulo: 'Aún no hay reportes resueltos', vacioTexto: 'La tendencia aparecerá cuando se resuelvan reportes en este periodo.'
            });
            });
            seguro(['g-areas'], function () { G.barras($('g-areas'), {
                series: [{ nombre: 'Abiertos', color: 'var(--s2)' }, { nombre: 'Cerrados', color: 'var(--s1)' }],
                filas: a.por_area.map(function (x) { return { clave: x.id, nombre: x.nombre + (x.activo ? '' : ' (inactiva)'), valores: [x.abiertos, x.cerrados] }; }),
                interactiva: true,
                seleccion: filtros.area || null,
                alElegir: function (f) { alternarFiltro('area', f.clave); },
                pista: 'Clic para ver solo esta área',
                tituloCategoria: 'Área', tabla: $('t-areas'),
                vacioTitulo: 'Sin áreas con reportes', vacioTexto: 'No hay reportes asignados con estos filtros.'
            }); });
            seguro(['g-categorias'], function () { G.barras($('g-categorias'), {
                series: [{ nombre: 'Reportes', color: 'var(--s1)' }],
                filas: a.categorias.map(function (c) { return { clave: c.categoria, nombre: c.categoria, valores: [c.n] }; }),
                seleccion: filtros.categoria || null,
                alElegir: function (f) { alternarFiltro('categoria', f.clave); },
                pista: 'Clic para ver solo esta categoría',
                tituloCategoria: 'Categoría', tabla: $('t-categorias'),
                vacioTitulo: 'Sin categorías', vacioTexto: 'No hay reportes con estos filtros.'
            }); });

            // Tipo de reporte: voluntarios (prevenir) frente a obligatorios (eventos con afectación)
            seguro(['g-tipos'], function () {
            if (faltanSeries(a, ['por_tipo_reporte'])) { G.vacio($('g-tipos'), 'Gráfica no disponible', SIN_SERIES, 'warn'); $('t-tipos').innerHTML = ''; nota('nota-tipos', ''); return; }
            var suma = function (g) { return a.por_tipo_reporte.filter(function (t) { return t.grupo === g; }).reduce(function (s, t) { return s + t.n; }, 0); };
            var vol = suma('voluntario'), obl = suma('obligatorio');
            var sinC = (a.por_tipo_reporte.find(function (t) { return t.clave === 'sin_clasificar'; }) || { n: 0 }).n;
            nota('nota-tipos', vol + obl
                ? 'Reportes voluntarios: ' + num(vol) + ' · obligatorios: ' + num(obl) +
                  (obl ? '. Por cada reporte obligatorio hubo ' + num(vol / obl, 1) + ' voluntarios.' : '.') +
                  (sinC ? ' ' + num(sinC) + ' reporte(s) anteriores a la clasificación quedan como “Sin clasificar”.' : '')
                : (sinC ? 'Los ' + num(sinC) + ' reporte(s) de este periodo son anteriores a la clasificación por tipo.' : ''));
            G.barras($('g-tipos'), {
                series: [{ nombre: 'Abiertos', color: 'var(--s2)' }, { nombre: 'Cerrados', color: 'var(--s1)' }],
                filas: a.por_tipo_reporte.filter(function (t) { return t.n > 0 || t.clave !== 'sin_clasificar'; })
                    .map(function (t) { return { clave: t.clave, nombre: t.nombre, valores: [t.n - t.cerrados, t.cerrados] }; }),
                interactiva: true,
                seleccion: filtros.tipo || null,
                alElegir: function (f) { alternarFiltro('tipo', f.clave); },
                pista: 'Clic para ver solo este tipo',
                tituloCategoria: 'Tipo de reporte', tabla: $('t-tipos'),
                vacioTitulo: 'Sin reportes', vacioTexto: 'No hay reportes con estos filtros.'
            });
            });

            seguro(['g-riesgo'], function () {
            var evaluados = a.riesgo.celdas.reduce(function (s, c) { return s + c.n; }, 0);
            $('avisoMatriz').hidden = d.matriz.validada;
            if (!evaluados) {
                G.vacio($('g-riesgo'), 'Aún no hay reportes con evaluación de riesgo',
                    a.riesgo.sin_evaluar + ' reporte(s) sin evaluar. Supervisión puede evaluarlos desde el detalle de cada reporte.', 'shield');
                $('g-niveles').innerHTML = '';
                $('t-riesgo').innerHTML = '';
            } else {
                G.matriz($('g-riesgo'), { matriz: d.matriz, conteos: a.riesgo.celdas, tabla: $('t-riesgo') });
                G.barras($('g-niveles'), {
                    series: [{ nombre: 'Reportes', color: 'var(--s1)' }],
                    filas: a.riesgo.niveles.map(function (n) { return { clave: n.clave, nombre: n.nombre, valores: [n.n] }; })
                        .concat([{ clave: 'sin_evaluar', nombre: 'Sin evaluar', valores: [a.riesgo.sin_evaluar] }]),
                    seleccion: filtros.riesgo || null,
                    alElegir: function (f) { alternarFiltro('riesgo', f.clave); },
                    pista: 'Clic para filtrar este nivel',
                    tituloCategoria: 'Nivel'
                });
            }
            });
        }

        // Filtros que no tienen control propio en esta barra (vienen de la vista general o de las gráficas)
        function valorLegible(c, v) {
            if (c === 'estado') return VALORES_ESTADO[v] || v;
            if (c === 'riesgo') return VALORES_RIESGO[v] || catalogo.niveles[v] || v;
            if (c === 'vencimiento') return VALORES_PLAZO[v] || v;
            if (c === 'responsable') return catalogo.areas[v] || 'Área ' + v;
            if (c === 'tipo') return catalogo.tipos[v] || v;
            return v;
        }
        function pintarActivos() {
            var extra = CAMPOS.filter(function (c) { return ['desde', 'hasta', 'area', 'categoria'].indexOf(c) < 0 && filtros[c]; });
            var chips = $('chipsActivos');
            chips.innerHTML = '';
            extra.forEach(function (c) {
                var s = document.createElement('span');
                s.className = 'chip-filtro';
                s.innerHTML = '<span><b></b> </span><button type="button">' + SMS.ic('x') + '</button>';
                s.querySelector('b').textContent = (ETIQUETAS_FILTRO[c] || c) + ':';
                s.querySelector('span').appendChild(document.createTextNode(' ' + valorLegible(c, filtros[c])));
                s.querySelector('button').setAttribute('aria-label', 'Quitar filtro ' + (ETIQUETAS_FILTRO[c] || c));
                s.querySelector('button').addEventListener('click', function () { delete filtros[c]; cargar(); });
                chips.appendChild(s);
            });
            $('filtrosActivos').hidden = extra.length === 0;
        }
        /** Contexto que acompaña a cada PNG exportado */
        function contextoTexto() {
            var r = filtros.fecha ? { desde: filtros.fecha, hasta: filtros.fecha } : (filtros.desde || filtros.hasta) ? { desde: filtros.desde || '…', hasta: filtros.hasta || 'hoy' } : null;
            var partes = ['Periodo: ' + (r ? (r.desde === r.hasta ? SMS.fecha(r.desde) : (r.desde === '…' ? '…' : SMS.fecha(r.desde)) + ' – ' + (r.hasta === 'hoy' ? 'hoy' : SMS.fecha(r.hasta))) : 'todo el historial')];
            if (filtros.area) partes.push('Área: ' + (catalogo.areas[filtros.area] || filtros.area));
            if (filtros.categoria) partes.push('Categoría: ' + filtros.categoria);
            CAMPOS.forEach(function (c) {
                if (['desde', 'hasta', 'fecha', 'area', 'categoria'].indexOf(c) < 0 && filtros[c]) partes.push((ETIQUETAS_FILTRO[c] || c) + ': ' + valorLegible(c, filtros[c]));
            });
            return 'S.A.G.A. · AIFA · Análisis estadístico de hallazgos SMS — ' + partes.join(' · ') + ' · Generado el ' + SMS.fechaHora(new Date());
        }

        function errorEn(id, e) {
            $(id).innerHTML = '<div class="sg-empty crit">' + SMS.ic('crit') + '<b>No se pudo cargar esta sección</b>' + SMS.esc(e.message) + '</div>';
        }
        async function cargarComparativo(senal) {
            try {
                var q = qs(); q.set('modo', modoComp);
                var c = await SMS.api('/api/sms/comparativo?' + q.toString(), { signal: senal });
                A.comparativo($('comparativo'), c);
                $('compNota').textContent = c.automatico
                    ? 'Sin periodo seleccionado: se compara el último mes con reportes contra ' + (modoComp === 'anio' ? 'el mismo mes del año anterior' : 'el mes anterior') + '. Elige un periodo arriba para cambiarlo.'
                    : 'Periodo seleccionado frente al ' + (modoComp === 'anio' ? 'mismo periodo del año anterior' : 'periodo anterior de igual duración') + '.';
            } catch (e) { if (e.name !== 'AbortError') errorEn('comparativo', e); }
        }
        async function cargar() {
            pintarForm();
            pintarActivos();
            if (controlador) controlador.abort();
            controlador = new AbortController();
            var senal = controlador.signal;
            // Al recargar se conserva el dibujo anterior atenuado (sin parpadeo)
            $('zona').classList.add('is-cargando');
            $('zona').setAttribute('aria-busy', 'true');
            var q = qs().toString();
            var tareas = [
                SMS.api('/api/sms/analisis?' + q, { signal: senal }).then(pintar).catch(function (e) {
                    if (e.name === 'AbortError') throw e;
                    // Sin datos que mostrar: cada gráfica sin dibujo previo explica el error
                    document.querySelectorAll('.grafica .viz').forEach(function (v) {
                        if (v.querySelector('.viz-skel')) G.vacio(v, 'No se pudo cargar la gráfica', e.message, 'crit');
                    });
                    throw e;
                }),
                cargarComparativo(senal),
                SMS.api('/api/sms/spi?' + q, { signal: senal }).then(function (d) {
                    A.spi($('spi'), d, { enlaceConfig: true });
                    $('spiNota').textContent = 'Valores mensuales (' + (d.meses.length ? SMS.mes(d.meses[0]) + ' – ' + SMS.mes(d.meses[d.meses.length - 1]) : 'sin periodo') + ') calculados con los registros; la meta y el nivel de alerta los configura la Gerencia de SMS.';
                }).catch(function (e) { if (e.name !== 'AbortError') errorEn('spi', e); }),
                SMS.api('/api/sms/desempeno-areas?' + q, { signal: senal }).then(function (d) { A.desempeno($('desempeno'), d, { enlaces: true }); })
                    .catch(function (e) { if (e.name !== 'AbortError') errorEn('desempeno', e); }),
                SMS.api('/api/sms/recurrencias?' + q, { signal: senal }).then(function (d) {
                    A.recurrencias($('recCategorias'), $('recLugares'), d, { enlaces: true });
                    $('recLugarT').textContent = d.zonas && d.zonas.grupos.length ? 'Por zona del aeropuerto' : 'Por lugar reportado';
                    $('recNota').textContent = 'Recurrente = ' + d.umbral + ' o más reportes en ' + d.ventana_dias + ' días (del ' + SMS.fecha(d.ventana.desde) + ' al ' + SMS.fecha(d.ventana.hasta) + '). ' +
                        (d.zonas && d.zonas.grupos.length ? '' : 'Los lugares se agrupan automáticamente a partir del texto capturado (por ejemplo, “cerca de la posición 505” y “Posición 505”).');
                }).catch(function (e) { if (e.name !== 'AbortError') { errorEn('recCategorias', e); $('recLugares').innerHTML = ''; } })
            ];
            try {
                await Promise.all(tareas);
            } catch (e) {
                if (e.name === 'AbortError') return;
                SAGA.toast('No se pudo cargar el análisis: ' + e.message, 'error');
            } finally {
                if (!senal.aborted) { $('zona').classList.remove('is-cargando'); $('zona').setAttribute('aria-busy', 'false'); }
            }
        }
        async function cargarCalidad() {
            try { A.calidad($('calidad'), await SMS.api('/api/sms/calidad-datos')); }
            catch (e) { errorEn('calidad', e); }
        }
        document.querySelectorAll('[data-modo]').forEach(function (b) {
            b.addEventListener('click', function () {
                modoComp = b.dataset.modo;
                document.querySelectorAll('[data-modo]').forEach(function (x) { x.setAttribute('aria-pressed', x === b ? 'true' : 'false'); });
                cargarComparativo();
            });
        });

        document.querySelectorAll('.preset').forEach(function (b) {
            b.addEventListener('click', function () {
                var r = rango(b.dataset.preset);
                if (r.desde) { filtros.desde = r.desde; filtros.hasta = r.hasta; } else { delete filtros.desde; delete filtros.hasta; }
                delete filtros.fecha;
                cargar();
            });
        });
        // Cambiar la agrupación solo reagrupa lo ya cargado (sin pedir datos de nuevo)
        document.querySelectorAll('[data-gran]').forEach(function (b) {
            b.addEventListener('click', function () {
                if (gran === b.dataset.gran) return;
                gran = b.dataset.gran;
                pintarForm();
                if (ultimo) seguro(['g-evolucion', 'g-periodos', 'g-flujo'], function () { pintarTiempo(ultimo); });
            });
        });
        $('formFiltros').addEventListener('change', function (e) {
            if (!e.target.id || e.target.id.indexOf('f_') !== 0) return;
            ['desde', 'hasta', 'area', 'categoria'].forEach(function (c) { var v = $('f_' + c).value; if (v) filtros[c] = v; else delete filtros[c]; });
            delete filtros.fecha;
            cargar();
        });
        $('btnRestablecer').addEventListener('click', function () {
            filtros = {};
            document.querySelectorAll('.grafica .viz').forEach(function (v) { if (v._vista) G.restablecer(v); });
            cargar();
        });

        // Acciones de cada tarjeta: restablecer vista y exportar PNG
        document.addEventListener('viz:vista', function (e) {
            var tarjeta = e.target.closest('.grafica');
            var b = tarjeta && tarjeta.querySelector('[data-restablecer-viz]');
            if (b) b.hidden = !e.detail.alterada;
        });
        document.addEventListener('click', function (e) {
            var r = e.target.closest('[data-restablecer-viz]');
            if (r) { G.restablecer($(r.getAttribute('data-restablecer-viz'))); return; }
            var png = e.target.closest('[data-png]');
            if (!png) return;
            var tarjeta = png.closest('.grafica');
            var titulo = (tarjeta.querySelector('.sg-card__title > span').firstChild.textContent || 'grafica').trim();
            var nombre = 'sms-' + titulo.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') + '-' + SMS.diaLocal() + '.png';
            png.disabled = true;
            G.exportarPNG(tarjeta, { nombre: nombre, pie: contextoTexto() })
                .then(function () { SAGA.toast('Imagen descargada: ' + nombre, 'success', { duracion: 3000 }); })
                .catch(function (err) { SAGA.toast('No se pudo exportar la imagen: ' + err.message, 'error'); })
                .finally(function () { png.disabled = false; });
        });

        $('expPdf').addEventListener('click', function () {
            SMS.cerrarMenus();
            var q = qs(); q.set('imprimir', '1');
            window.open('/reportes/ejecutivo?' + q.toString(), '_blank', 'noopener');
        });
        $('expExcel').addEventListener('click', async function () {
            SMS.cerrarMenus();
            try { await SMS.descargar('/api/sms/exportar.xlsx?' + qs().toString(), 'reportes-sms-aifa-' + SMS.diaLocal() + '.xlsx'); SAGA.toast('Archivo de Excel descargado', 'success'); }
            catch (e) { SAGA.toast(e.message, 'error'); }
        });

        leerURL();
        catalogos().then(cargar);
        cargarCalidad();

    })();
    </script>
</body>
</html>
