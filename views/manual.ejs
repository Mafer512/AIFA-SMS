    <title>Manual de usuario · S.A.G.A. AIFA</title>
<%- include('partials/head') %>
    <style>
        .manual { display: grid; gap: 28px; grid-template-columns: minmax(0, 1fr); align-items: start; }
        @media (min-width: 1000px) { .manual { grid-template-columns: 260px minmax(0, 1fr); } }
        .indice { position: sticky; top: calc(var(--appbar-h, 64px) + 16px); max-height: calc(100vh - var(--appbar-h, 64px) - 32px); overflow-y: auto; }
        @media (max-width: 999px) { .indice { position: static; max-height: none; } }
        .indice .buscar { margin-bottom: 12px; }
        .indice ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 1px; counter-reset: sec; }
        .indice li { counter-increment: sec; }
        .indice a { display: flex; gap: 8px; padding: 7px 10px; border-radius: 6px; font-size: 13.5px; color: var(--n700); text-decoration: none; line-height: 1.35; }
        .indice a::before { content: counter(sec) "."; min-width: 18px; color: var(--n400); font-variant-numeric: tabular-nums; }
        .indice a:hover { background: var(--n50); color: var(--n900); }
        .indice a.is-activo { background: var(--v50); color: var(--v800); font-weight: 600; }
        .indice a:focus-visible { outline: none; box-shadow: var(--focus); }
        .indice li[hidden] { display: none; }
        @media (max-width: 999px) { .indice ol { grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); } }

        .contenido { max-width: 820px; min-width: 0; }
        .sec { scroll-margin-top: calc(var(--appbar-h, 64px) + 16px); padding: 26px 28px; background: var(--sf); border: 1px solid var(--n100); border-radius: 12px; box-shadow: var(--sh-sm); }
        .sec + .sec { margin-top: 18px; }
        .sec[hidden] { display: none; }
        @media (max-width: 600px) { .sec { padding: 20px 16px; } }
        .sec h2 { display: flex; align-items: center; gap: 10px; font-size: 21px; margin-bottom: 6px; }
        .sec h2 .ic { width: 22px; height: 22px; color: var(--v700); flex: none; }
        .sec h3 { font-size: 15.5px; margin: 22px 0 8px; color: var(--n900); scroll-margin-top: calc(var(--appbar-h, 64px) + 16px); }
        .sec p, .sec li { font-size: 14.5px; line-height: 1.65; color: var(--n800); }
        .sec p + p { margin-top: 8px; }
        .sec .lead { color: var(--n600); margin-bottom: 4px; }
        .sec ul, .sec ol.pasos { margin: 8px 0 0; padding-left: 22px; }
        .sec li + li { margin-top: 4px; }
        .sec ol.pasos li::marker { font-weight: 700; color: var(--v700); }
        .sec .quien { display: inline-flex; align-items: center; gap: 6px; margin-top: 6px; padding: 3px 9px; border-radius: 4px; background: var(--n50); border: 1px solid var(--n100); font-size: 12.5px; color: var(--n700); }
        .sec .quien .ic { width: 14px; height: 14px; }
        .sec table { width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 13.5px; }
        .sec th, .sec td { padding: 9px 10px; border-bottom: 1px solid var(--n100); text-align: left; vertical-align: top; }
        .sec thead th { font: 700 10.5px var(--ft); letter-spacing: .1em; text-transform: uppercase; color: var(--n600); background: var(--n50); }
        .sec td.c { text-align: center; }
        .tabla-x { overflow-x: auto; }
        .sec kbd { display: inline-block; padding: 1px 6px; border: 1px solid var(--n200); border-bottom-width: 2px; border-radius: 4px; font: 600 12px var(--fm); background: var(--n50); color: var(--n800); }
        .sec .btn-ej { display: inline-flex; align-items: center; gap: 5px; padding: 1px 8px; border: 1px solid var(--n200); border-radius: 6px; font-size: 13px; font-weight: 600; color: var(--n800); background: var(--sf); white-space: nowrap; vertical-align: baseline; }
        .sec .btn-ej .ic { width: 14px; height: 14px; }
        .sec .sg-banner { margin-top: 12px; }
        .flujo { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 8px; margin: 12px 0 4px; font-size: 13px; }
        .flujo .paso { padding: 6px 10px; border-radius: 6px; border: 1px solid var(--n200); background: var(--n50); font-weight: 600; color: var(--n800); }
        .flujo .ic { width: 16px; height: 16px; color: var(--n400); }
        .ejemplos { display: flex; flex-wrap: wrap; gap: 10px 18px; margin-top: 10px; }
        .faq details { border: 1px solid var(--n100); border-radius: 8px; padding: 0 14px; }
        .faq details + details { margin-top: 8px; }
        .faq summary { cursor: pointer; padding: 12px 0; font-weight: 600; font-size: 14.5px; color: var(--n900); }
        .faq details[open] summary { border-bottom: 1px solid var(--n100); margin-bottom: 10px; }
        .faq details > :last-child { margin-bottom: 12px; }
        mark { background: color-mix(in srgb, var(--amb) 35%, transparent); color: inherit; border-radius: 2px; padding: 0 1px; }
        .sin-resultados { padding: 28px; text-align: center; color: var(--n500); }
        .portada { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
        @media print {
            .indice, .portada .btn { display: none !important; }
            .manual { display: block; }
            .contenido { max-width: none; }
            .sec { box-shadow: none; border: 0; padding: 0; break-inside: auto; }
            .sec + .sec { margin-top: 24px; padding-top: 18px; border-top: 1px solid var(--n200); }
            .sec h2, .sec h3 { break-after: avoid; }
            .faq details { border: 0; padding: 0; }
            .faq details > * { display: block; }
        }
    </style>
</head>
