            SMS.semaforo({ estado: 'A' }, 7),
            SMS.semaforo({ estado: 'D', cerrado_en_plazo: true }, 7, { sinDetalle: true }),
            SMS.semaforo({ estado: 'D', cerrado_en_plazo: false }, 7, { sinDetalle: true })
        ].join('');

        // Sección activa en el índice
        if ('IntersectionObserver' in window) {
            var obs = new IntersectionObserver(function (entradas) {
                entradas.forEach(function (e) {
                    if (!e.isIntersecting) return;
                    enlaces.forEach(function (a) { a.classList.toggle('is-activo', a.getAttribute('href') === '#' + e.target.id); });
                });
            }, { rootMargin: '-20% 0px -70% 0px' });
            secciones.forEach(function (s) { obs.observe(s); });
        }

        // Búsqueda: oculta secciones sin coincidencias y resalta el texto
        var originales = secciones.map(function (s) { return s.innerHTML; });
        function normal(t) { return t.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase(); }
        function resaltar(nodo, q) {
            var walker = document.createTreeWalker(nodo, NodeFilter.SHOW_TEXT, null);
            var textos = [];
            while (walker.nextNode()) textos.push(walker.currentNode);
            textos.forEach(function (t) {
                var n = normal(t.nodeValue), i = n.indexOf(q);
                if (i < 0 || !t.nodeValue.trim()) return;
                var frag = document.createDocumentFragment(), pos = 0;
                while (i >= 0) {
                    frag.appendChild(document.createTextNode(t.nodeValue.slice(pos, i)));
                    var m = document.createElement('mark'); m.textContent = t.nodeValue.slice(i, i + q.length); frag.appendChild(m);
                    pos = i + q.length; i = n.indexOf(q, pos);
                }
                frag.appendChild(document.createTextNode(t.nodeValue.slice(pos)));
                t.parentNode.replaceChild(frag, t);
            });
        }
        var temporizador;
        document.getElementById('buscar').addEventListener('input', function () {
            var campo = this;
            clearTimeout(temporizador);
            temporizador = setTimeout(function () {
                var q = normal(campo.value.trim());
                var visibles = 0;
                secciones.forEach(function (s, i) {
                    s.innerHTML = originales[i];
                    var coincide = !q || normal(s.textContent).indexOf(q) >= 0;
                    s.hidden = !coincide;
                    indice.querySelector('[data-para="' + s.id + '"]').hidden = !coincide;
                    if (coincide) { visibles++; if (q.length >= 2) { resaltar(s, q); s.querySelectorAll('details').forEach(function (d) { if (d.querySelector('mark')) d.open = true; }); } }
                });
                document.getElementById('sinResultados').hidden = visibles > 0;
            }, 200);
        });

        document.getElementById('btnImprimir').addEventListener('click', function () {
            document.querySelectorAll('.faq details').forEach(function (d) { d.open = true; });
            window.print();
        });
    })();
    </script>
</body>
</html>
