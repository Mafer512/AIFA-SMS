

# Configuración del servidor
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=aifa_rsm

# Límites del sistema
MAX_FILE_SIZE_MB=50
MAX_IMAGE_SIZE_MB=10
MAX_FILES_PER_REPORT=5
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=5

# CORS
CORS_ORIGIN=*
CORS_CREDENTIALS=true

# Logs
LOG_LEVEL=info
LOG_FILE=logs/rsm.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=14d

# Sesiones: clave secreta propia. En producción (NODE_ENV=production) es obligatoria,
# de al menos 32 caracteres aleatorios; el servidor no arranca sin ella. Generar una con:
#   npm run generar-clave
JWT_SECRET=cambia-esta-clave

# Fotos de evidencia. En un servidor conviene una carpeta fuera del código para que
# no se pierda al actualizar la aplicación, p. ej. UPLOADS_DIR=/home/USUARIO/sms-datos/uploads
# UPLOADS_DIR=uploads

# Respaldos automáticos de la base de datos (cada 24 h mientras el servidor está encendido)
RESPALDO_AUTOMATICO=1
RESPALDOS_DIR=respaldos
RESPALDOS_CONSERVAR=30
# Ruta de mysqldump si no está en el PATH, p. ej.:
# MYSQLDUMP_PATH=C:\Program Files\MySQL\MySQL Server 8.4\bin\mysqldump.exe
